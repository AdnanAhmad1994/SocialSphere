# Environment variables for SocialSphere (Vercel)

# Required for database (Neon/Postgres over HTTP for serverless functions)
DATABASE_URL=

# JWT for API auth tokens (api/_lib/auth.ts)
JWT_SECRET=

# Session secret (used if you run the Express server locally)
SESSION_SECRET=dev-secret-change-me

# Optional: OIDC/Replit auth (not required for Vercel serverless APIs)
ISSUER_URL=
REPL_ID=
REPLIT_DOMAINS=

# Optional: Object storage/public files path override (local dev)
PUBLIC_OBJECT_SEARCH_PATHS=
